{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    { "src": "^/([^/\\\\].*)/$", "headers": { "Location": "/$1" }, "status": 308 },
    { "src": "^/pricing$", "headers": { "Location": "/challenges" }, "status": 308 },
    { "src": "^/(ar|fr|es|pt|tr)/pricing$", "headers": { "Location": "/$1/challenges" }, "status": 308 },
    { "src": "^/favicon\\.ico$", "headers": { "Location": "/brand/favicon.ico" }, "status": 308 },
    { "src": "^/((?:ar|en)/(?:signin|signup|reset|verify|2fa|home|accounts|account|shop|checkout|orders|payouts|certificates|notifications|profile|more|legal|manifest\\.webmanifest)(?:/.*)?)$", "headers": { "Location": "https://app.fptraders.app/$1" }, "status": 308 },
    { "src": "^/(signin|signup|c/[^/]+|mock-gateway(?:/.*)?)$", "headers": { "Location": "https://app.fptraders.app/$1" }, "status": 308 },
    { "src": "^/en$", "headers": { "Location": "/" }, "status": 308 },
    { "src": "^/en/([^/\\\\].*)$", "headers": { "Location": "/$1" }, "status": 308 },
    { "src": "^/images/fiper/(.*)$", "headers": { "Location": "/images/third-party/fiper/$1" }, "status": 308 },
    { "src": "^/images/ctrader/(.*)$", "headers": { "Location": "/images/third-party/ctrader/$1" }, "status": 308 },
    { "src": "^/brand/fonts/(.*)$", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "^/fonts/(.*)\\.woff2$", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "^/assets/(.*)$", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "^/sw\\.js$", "headers": { "Cache-Control": "no-cache", "Service-Worker-Allowed": "/" }, "continue": true },
    { "src": "^/offline\\.html$", "headers": { "Cache-Control": "no-cache" }, "continue": true },
    { "handle": "error" },
    { "src": "^/(ar|fr|es|pt|tr)(?:/.*)?$", "dest": "/$1/404.html", "status": 404 },
    { "src": "^/.*$", "dest": "/404.html", "status": 404 }
  ]
}
